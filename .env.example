# Database Configuration
POSTGRES_DB=house_prices
POSTGRES_USER=prices
POSTGRES_PASSWORD=your_secure_password_here

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=admin_password_here
GRAFANA_ROOT_URL=http://localhost:3001/grafana

# Ingest Configuration
TARGET_COUNTIES=ESSEX,HERTFORDSHIRE,KENT,SURREY,CAMBRIDGESHIRE

# LLM Server Configuration (llama.cpp, OpenAI-compatible API)
# NOTE: for the /ask agent, launch llama.cpp with --ctx-size 8192 or higher.
LLM_HOST=http://localhost:8080
LLM_MODEL=Qwen3-8B-Q4_K_M.gguf

# Conversational Analytics Agent (/ask)
# Dedicated read-only Postgres role; create via postgres/init/02_agent_readonly.sql
AGENT_DB_USER=agent_ro
AGENT_DB_PASSWORD=readonly_password_here
AGENT_MAX_STEPS=3
AGENT_MAX_ROWS=25
AGENT_SQL_ROW_LIMIT=500
AGENT_TOOL_MODE=structured

# EPC (Energy Performance Certificates) — adds floor area / £-per-m² / energy rating.
# Initial full load: manual GOV.UK One Login bulk download into ./epc_data (gitignored),
# then: docker compose run --rm epc-ingest python epc_ingest.py --mode bulk
# Quarterly top-ups via the developer API need a key (sign in via One Login to get it).
# Leave blank if you only ever do the offline bulk load. NEVER put your One Login password here.
EPC_DIR=./epc_data
# EPC_API_EMAIL=you@example.com
# EPC_API_KEY=your_epc_developer_api_key

# Optional: Uncomment to override defaults
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432